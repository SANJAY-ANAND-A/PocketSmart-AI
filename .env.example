# ==================================================
# PocketSmart AI - Environment Configuration Template
# Copy this file to .env before starting the backend
# ==================================================

# Application
PROJECT_NAME="PocketSmart AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# Currency Configuration
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"

# Security & Authentication
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY="pocketsmart-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite database
DATABASE_URL="sqlite:///./pocketsmart.db"
# Example PostgreSQL for future deployment:
# DATABASE_URL="postgresql://user:password@localhost:5432/pocketsmart"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# AI / Google Gemini
# Keep only in backend. NEVER expose to frontend.
# If left empty, the application automatically uses the deterministic rule-based fallback engine.
GEMINI_API_KEY=""
# Recommended default model: gemini-2.5-flash
GEMINI_MODEL="gemini-3.1-flash-lite"

# File Uploads (Jewelry outfit image)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
